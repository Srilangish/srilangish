        humanoid.Sit = false
        humanoid.PlatformStand = false
    end
end)

local function floatInVoid()
    if not root or not root.Parent then return end
    root.CFrame = CFrame.new(root.Position.X, VOID_Y, root.Position.Z)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

task.spawn(function()
    while true do
        if not farming then
            statusLabel.Text = "Status: Paused"
            SideStatus.Text = "Status: Paused"
            task.wait(0.4)
        else
            if not character or not humanoid or humanoid.Health <= 0 or not root or not root.Parent then
                statusLabel.Text = "Status: Waiting for character..."
                SideStatus.Text = "Status: Waiting char..."
                task.wait(1)
            elseif not equipCombat() then
                statusLabel.Text = "Status: Waiting for Combat tool..."
                SideStatus.Text = "Status: Need Combat"
                task.wait(0.6)
            else
                local cashiers = getCashiers()
                if #cashiers == 0 then
                    statusLabel.Text = "Status: No Cashiers → Floating"
                    SideStatus.Text = "Status: Floating"
                    floatInVoid()
                    task.wait(1.2)
                else
                    statusLabel.Text = "Status: Farming " .. #cashiers .. " Cashier(s)"
                    SideStatus.Text = "Status: Farming " .. #cashiers
                    for _, cashier in ipairs(cashiers) do
                        if not farming or not humanoid or humanoid.Health <= 0 then break end
                        if not isCashierValid(cashier) then continue end

                        attackCashier(cashier)

                        for i = 1, 6 do
                            clickMoneyDrops()
                            task.wait(0.1)
                        end

                        visitedCount += 1
                        if visitedCount % 5 == 0 then
                            sendWebhook(
                                "Farm Progress",
                                "**Cashiers Visited:** " .. visitedCount ..
                                "\n**DHC Earned:** $" .. (getDHC() - startDHC) ..
                                "\n**Time:** " .. formatTime(math.floor(tick() - startTime))
                            )
                        end
                        task.wait(DELAY_BETWEEN_CASHIERS)
                    end
                end
            end
            task.wait(0.2)
        end
    end
end)

task.spawn(function()
    while true do
        if farming and humanoid and humanoid.Health > 0 then
            clickMoneyDrops()
            equipCombat()
        end
        task.wait(0.3)
    end
end)

