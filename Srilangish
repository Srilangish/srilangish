local function findCombatInInventory()
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("combat") or tool.Name == "[Combat]") then
                return tool
            end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("combat") or tool.Name == "[Combat]") then
                return tool
            end
        end
    end
    return nil
end

local function equipCombat()
    local combat = findCombatInInventory()
    if combat and humanoid then
        if combat.Parent ~= character then
            humanoid:EquipTool(combat)
        end
        return true
    end
    return false
end

-- Hold LEFT click for duration while locked in front of cashier
local function holdLeftClickInFront(model, duration)
    local targetPart = model:IsA("BasePart") and model or (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
    if not targetPart then return end

    local start = tick()
    pcall(function()
        if mouse1press then
            mouse1press()
        else
            VirtualUser:Button1Down(Vector2.new(), workspace.CurrentCamera.CFrame)
        end
    end)

    while tick() - start < duration and farming do
        if not character or not humanoid or humanoid.Health <= 0 or not root or not root.Parent then break end
        local targetCFrame = targetPart.CFrame * CFrame.new(0, 0, -2.5) * CFrame.Angles(0, math.rad(180), 0)
        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        equipCombat()
        pcall(function()
            if mouse1press then
                mouse1press()
            else
                VirtualUser:Button1Down(Vector2.new(), workspace.CurrentCamera.CFrame)
            end
        end)
        RunService.Heartbeat:Wait()
    end

    pcall(function()
        if mouse1release then
            mouse1release()
        else
            VirtualUser:Button1Up(Vector2.new(), workspace.CurrentCamera.CFrame)
        end
    end)
end

function isCashierValid(obj)
    if not obj or not obj.Parent or not obj:IsA("Model") then return false end
    local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    if not part or not part.Parent or not part:IsDescendantOf(workspace) then return false end
    if obj:GetAttribute("Broken") or obj:GetAttribute("Destroyed") then return false end
    if part.Transparency >= 0.9 then return false end
    return true
end

-- 2 left-click holds (4s each) + stay 2s
local function attackCashier(model)
    local targetPart = model:IsA("BasePart") and model or (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
    if not targetPart then return end

    for hold = 1, HOLD_COUNT do
        if not farming or not humanoid or humanoid.Health <= 0 then break end
        if not isCashierValid(model) then break end
        statusLabel.Text = "Status: LMB Hold " .. hold .. "/" .. HOLD_COUNT .. " (4s)"
        SideStatus.Text = "Status: Hold " .. hold .. "/" .. HOLD_COUNT
        holdLeftClickInFront(model, HOLD_TIME)
        task.wait(0.1)
    end

    statusLabel.Text = "Status: Staying 2s..."
    SideStatus.Text = "Status: Staying 2s..."
    local stayStart = tick()
    while tick() - stayStart < STAY_AFTER and farming do
        if not character or not humanoid or humanoid.Health <= 0 or not root or not root.Parent then break end
        if not isCashierValid(model) then break end
        local targetCFrame = targetPart.CFrame * CFrame.new(0, 0, -2.5) * CFrame.Angles(0, math.rad(180), 0)
        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        RunService.Heartbeat:Wait()
    end
end

local function clickMoneyDrops()
    if not root or not root.Parent then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "MoneyDrop" then
            local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
            if part and (part.Position - root.Position).Magnitude <= MONEYDROP_RADIUS then
                for i = 1, 3 do
                    pcall(function()
                        firetouchinterest(root, part, 0)
                        task.wait(0.015)
                        firetouchinterest(root, part, 1)
                    end)
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new())
                    end)
                    local detector = obj:FindFirstChildOfClass("ClickDetector") or part:FindFirstChildOfClass("ClickDetector")
                    if detector then pcall(fireclickdetector, detector) end
                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or part:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then pcall(fireproximityprompt, prompt) end
                    task.wait(0.015)
                end
            end
        end
    end
end

local function getCashiers()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "CA$HIER" and isCashierValid(obj) then
            table.insert(list, obj)
        end
    end
    return list
end

